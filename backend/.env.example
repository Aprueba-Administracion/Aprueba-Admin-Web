# ── Puerto del API (solo desarrollo local) ──
PORT=4000

# ── JWT ──
JWT_SECRET=cambia-esto-en-produccion
JWT_ACCESS_TTL=900          # 15 min (segundos)
JWT_REFRESH_TTL=2592000     # 30 días (segundos)

# ── Firestore ──
# Proyecto de GCP / Firebase
GCLOUD_PROJECT=aprueba-dev

# OPCIÓN A · Firestore REAL, desarrollo local:
#   Apunta a un archivo de credenciales de cuenta de servicio (NO lo subas a git).
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# OPCIÓN B · Firestore REAL, producción en Vercel:
#   Pega el JSON completo de la cuenta de servicio como UNA sola línea en la
#   variable de entorno del proyecto en Vercel (Settings → Environment Variables).
#   No se define aquí en texto plano; ejemplo de forma (no un valor real):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}

# OPCIÓN C · Emulador local (no requiere credenciales de GCP):
#   Levanta el emulador con `npm run emulator` y descomenta:
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
